rm -o -s 0:/b9
rm -o -s 0:/SafeB9S.bin
rm -o -s 0:/_INSTRUCTIONS.txt
rm -o -s 0:/errors.txt

set PREVIEW_MODE "問題をチェック中... 完了\n許可を求めています... 完了\nホームブリューをインストール中... 完了\nGodMode9 を CTRNAND にコピー中... 完了\nSD カードをクリーンアップ中... 完了\n> essential.exefs をバックアップ中...\nNAND をバックアップ中... ---"

if find 0:/gm9/flags/INSTALLFLAG NULL
	set PREVIEW_MODE "問題をチェック中... 完了\n許可を求めています... 完了\nホームブリューをインストール中... スキップ\nGodMode9 を CTRNAND にコピー中... 完了\nSD カードをクリーンアップ中... 完了\n> essential.exefs をバックアップ中...\n> NAND をバックアップ中... ---"
end

# essential.exefs をバックアップ

if not find 0:/gm9/backups NULL
	mkdir 0:/gm9/backups
end
findnot 0:/gm9/backups/$[SERIAL]_essential_??.exefs OUTPATH
cp -w S:/essential.exefs $[OUTPATH]

set PREVIEW_MODE "問題をチェック中... 完了\n許可を求めています... 完了\nホームブリューをインストール中... 完了\nGodMode9 を CTRNAND にコピー中... 完了\nSD カードをクリーンアップ中... 完了\nessential.exefs をバックアップ中... 完了\n> NAND をバックアップ中..."

if find 0:/gm9/flags/INSTALLFLAG NULL
	set PREVIEW_MODE "問題をチェック中... 完了\n許可を求めています... 完了\nホームブリューをインストール中... スキップ\nGodMode9 を CTRNAND にコピー中... 完了\nSD カードをクリーンアップ中... 完了\nessential.exefs をバックアップ中... 完了\n> NAND をバックアップ中... ---"
end

# NAND バックアップ

if find 0:/gm9/flags/BACKUPFLAG NULL
	goto BACKUPSKIP
end

findnot 0:/gm9/backups/$[DATESTAMP]_$[SERIAL]_sysnand_??.bin OUTPATH

if	cp -h S:/nand_minsize.bin $[OUTPATH]
else
	set PREVIEW_MODE "9:/finalize/img/error06.png"
 	echo "エラー #06: NAND バックアップ fail\n \nNAND バックアップが何らかの理由で失敗しました\u3002\n(キャンセルしましたか？）\nDiscord を。。。論じてください\uff1a\nhttps://discord.gg/MWxPgEp"
	poweroff
end
goto CLEANUP

@NOSPACE # SD が椅堂のために子後退佋をてくぶり

set PREVIEW_MODE "問題をチェック中... 3DS フォルダがない\n> NAND をバックアップ中..."
if not find 0:/gm9/backups NULL
	mkdir 0:/gm9/backups
end
findnot 0:/gm9/backups/$[DATESTAMP]_$[SERIAL]_sysnand_??.bin OUTPATH

if	cp -h S:/nand_minsize.bin $[OUTPATH]
else
	set PREVIEW_MODE "9:/finalize/img/error06_nospace.png"
 	echo "エラー #06: NAND バックアップ fail\n \nNAND バックアップが何らかの理由で失敗しました\u3002\n(空き容量を消費しましたか？）\nDiscord を。。。論じてください\uff1a\nhttps://discord.gg/MWxPgEp"
	poweroff
end

if not find 0:/gm9/flags NULL
	mkdir 0:/gm9/flags
end
if find 0:/gm9/flags/BACKUPFLAG NULL
	rm -o -s 0:/gm9/flags/BACKUPFLAG
end
	
set BACKUPFLAG 0:/gm9/flags/BACKUPFLAG
if not fdummy $[BACKUPFLAG] 400
	set PREVIEW_MODE "9:/finalize/img/error15.png"
 	echo "誊告エラー #15: ファイル作成 fail\n \n0:/gm9/flags/BACKUPFLAG を作成できません\u3002\n(どうしたのでしょう？）\n \nDiscord を。。。論じてください\uff1a\nhttps://discord.gg/MWxPgEp"
	poweroff
end

set PREVIEW_MODE "9:/finalize/img/emptysd_complete.png"
echo "NAND バックアップが完了しました\u3002\nSD:/gm9/backups の 2 つ の SysNAND ファイルを、\nコンピュータの安全な場所にコピーしてから、\nSD カードから削除してください\u3002\nその一一、Nintendo 3DS フォルダを\nSD カードに抱いて、このスクリプトを\nもう一度実行してください\u3002\n \nNintendo 3DS フォルダバックアップがない場合、\nHOME メニューを開いてから、このスクリプトをもう一度実行してください\u3002"
poweroff

@CLEANUP # Self-removes script and remove script flags

if find 0:/gm9/flags/INSTALLFLAG NULL
	set PREVIEW_MODE "Checking for problems... DONE\nAsking for permission... DONE\nInstalling homebrew... SKIP\nCopying GodMode9 to CTRNAND... DONE\nCleaning up SD card... DONE\nBacking up essential.exefs... DONE\nBacking up NAND... DONE"
	goto INSTALLSKIP
end

cp -w 9:/finalize/gm9/scripts/GM9Megascript.gm9 0:/gm9/scripts/GM9Megascript.gm9
cp -w -o -s G:/finalize/gm9/languages 0:/gm9/languages
rm -o -s 0:/gm9/scripts/finalize.gm9
rm -o -s 0:/finalize.romfs

set PREVIEW_MODE "9:/finalize/img/complete.png"

echo "Success: Setup complete! :D\n \nRemember to backup the contents of\nSD:/gm9/backups to somewhere safe."
# rm -o -s 0:/finalize
rm -o -s 0:/gm9/flags

poweroff

@BACKUPSKIP

cp -w 9:/finalize/gm9/scripts/GM9Megascript.gm9 0:/gm9/scripts/GM9Megascript.gm9
cp -w -o -s G:/finalize/gm9/languages 0:/gm9/languages
rm -o -s 0:/gm9/scripts/finalize.gm9
rm -o -s 0:/finalize.romfs

set PREVIEW_MODE "9:/finalize/img/complete_backupflag.png"

if find 0:/gm9/flags/INSTALLFLAG NULL
	echo "成功：セットアップが完了しました！ :D\n \nSD:/gm9/backups の内容を\n安全な場所にバックアップしてをこう\u3002\n \n警告：NAND バックアップが自動スキップされました！\n別のバックアップを作成したい場合、\n以下の椿告に従ってください\uff1a\nhttps://tinyurl.com/gm9nandbackup\n警告：User 要求により CIA インストールをスキップしました！"
else
	echo "成功：セットアップが完了しました！ :D\n \nSD:/gm9/backups の内容を\n安全な場所にバックアップしてをこう\u3002\n \n警告：NAND バックアップが自動スキップされました！\n別のバックアップを作成したい場合、\n以下の椿告に従ってください\uff1a\nhttps://tinyurl.com/gm9nandbackup"
end

# rm -o -s 0:/finalize
rm -o -s 0:/gm9/flags
poweroff

@BACKUPDUPE

set PREVIEW_MODE "9:/finalize/img/error17.png"

ask "情報 #17: 重複 NAND バックアップ\n既に NAND バックアップを作成したをのようです\u3002\n \nホームブリューアプリケーションをインストールしたい場合、\nSD:/gm9/backups から NAND バックアップを\nコンピュータの安全な場所にコピーし、\nSD カードから削除し、\nNintendo 3DS フォルダを SD カードに\n抱いて。\n(フォルダを失った場合、\nSD を挿入したまま HOME メニューを\n開いて、フォルダを惋状を、リジェネレートをできます。）\n \n(A) を担んで、それでも NAND バックアップを作成してきて、\n(B) を担んで中止して\u3002"
goto NOSPACE

@INSTALLSKIP

cp -w 9:/finalize/gm9/scripts/GM9Megascript.gm9 0:/gm9/scripts/GM9Megascript.gm9
cp -w -o -s G:/finalize/gm9/languages 0:/gm9/languages
rm -o -s 0:/gm9/scripts/finalize.gm9
rm -o -s 0:/finalize.romfs

set PREVIEW_MODE "9:/finalize/img/complete_installflag.png"

echo "成功：セットアップが完了しました！ :D\n \nSD:/gm9/backups の内容を\n安全な場所にバックアップしてをこう\u3002\n \n警告：User 要求により CIA インストールをスキップしました！"
# rm -o -s 0:/finalize
rm -o -s 0:/gm9/flags

poweroff

