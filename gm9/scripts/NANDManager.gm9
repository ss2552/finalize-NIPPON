@NAND_Manager
@nm_menu
labelsel -k -o -s "オプションを選択してください。" nmopt_*
goto nm_menu
#goto options_main

@nmopt_A_Backup_EmuNAND
# EmuNANDバックアップ GM9スクリプト
# [SERIAL]_nandmin_???.binという名前でバックアップを作成します
# 作成者: d0k3
set ERRORMSG "EmuNANDバックアップに失敗しました"
set SUCCESSMSG "EmuNANDバックアップが成功しました"
if ask "EmuNANDバックアップを $[GM9OUT] に作成しますか？"
    findnot $[GM9OUT]/$[DATESTAMP]_$[SERIAL]_emunand_???.bin OUTPATH
    cp -h E:/nand_minsize.bin $[OUTPATH]
    echo "バックアップが正常に作成されました:\n$[OUTPATH]"
end
goto nm_menu

@nmopt_X_Backup_SysNAND
# SysNANDバックアップ GM9スクリプト
# [SERIAL]_nandmin_???.binという名前でバックアップを作成します
# 作成者: d0k3
set ERRORMSG "SysNANDバックアップに失敗しました"
set SUCCESSMSG "SysNANDバックアップが成功しました"
if ask "SysNANDバックアップを $[GM9OUT] に作成しますか？"
    findnot $[GM9OUT]/$[DATESTAMP]_$[SERIAL]_sysnand_???.bin OUTPATH
    cp -h S:/nand_minsize.bin $[OUTPATH]
    echo "バックアップが正常に作成されました:\n$[OUTPATH]"
end
goto nm_menu

@nmopt_Y_Restore_EmuNAND
# EmuNAND復元 GM9スクリプト
# 0:/gm9/outからバックアップを復元します。バックアップスクリプトからの名前スキームを想定しています
# 作成者: Kazuma77
set SUCCESSMSG "EmuNANDが正常に復元されました。"
set ERRORMSG "EmuNANDは変更されませんでした。"
if filesel "NANDバックアップを選択してください。" $[GM9OUT]/*nand_???.bin NANDBAK
    if ask "以下をEmuNANDに復元しますか？\n$[NANDBAK]"
        allow E:/nand.bin
        imgmount $[NANDBAK]
        if find I:/nand_minsize.bin NULL
            # 下の「verify」コマンドのコメントを外すと検証が有効になります。
            # EmuNANDは重要ではないため、コメントアウトしてあります。
            # さらに、EmuNANDはfirmパーティションを使用しません。
            #verify I:/nand_minsize.bin
            set ERRORMSG "転送中にエラーが発生しました\nもう一度試してください。"
            inject -n I:/nand_minsize.bin E:/nand.bin@0
            rm -o -s 4:/data/$[EMUID0]/sysdata/00010011/00000000
            imgumount
        else
            echo "有効なNANDバックアップではありません。"
        end
    end
end
goto nm_menu

@nmopt_L_Restore_SysNAND_(Full)
# SysNAND完全復元 GM9スクリプト
# 0:/gm9/outからバックアップを復元します。バックアップスクリプトからの名前スキームを想定しています
# 作成者: Kazuma77
set SUCCESSMSG "SysNANDが正常に復元されました。"
# GatewayはEmuNANDのfirmパーティションを保護するために使用されました。
# Gatewayを実行中に更新された古いEmuNANDイメージはデバイスをブリックする可能性があります。
# リスクを理解している場合は、次の2行をコメントアウトしてください。
set ERRORMSG "このスクリプトはntrubootで実行する必要があります。"
chk $[HAX] "ntrboot"
set ERRORMSG "SysNANDは変更されませんでした。"
if filesel "NANDバックアップを選択してください。" $[GM9OUT]/*nand_???.bin NANDBAK
    if ask "警告:\nシステムエクスプロイトは保護されません。\nこのスクリプトでEmuNANDイメージを使用しないでください\n- デバイスがブリックする可能性があります。\n \n以下をSysNANDに完全に復元しますか？\n$[NANDBAK]"
        allow S:/nand.bin
        imgmount $[NANDBAK]
        if verify I:/nand_minsize.bin
            set ERRORMSG "転送中にエラーが発生しました\nもう一度試してください。"
            inject -n I:/nand_minsize.bin S:/nand.bin@0
            rm -o -s 1:/data/$[SYSID0]/sysdata/00010011/00000000
            imgumount
        else
            echo "有効なNANDバックアップではありません。"
        end
    end
end
goto nm_menu

@nmopt_R_Restore_SysNAND_(Safe)
# SysNAND安全復元 GM9スクリプト
# 0:/gm9/outからバックアップを復元します。バックアップスクリプトからの名前スキームを想定しています
# 作成者: Kazuma77
set SUCCESSMSG "SysNANDが正常に復元されました。"
set ERRORMSG "適切なエクスプロイトが見つかりません。\nユニットのブリックを避けるために中止しています。"
chk -u $[HAX] ""
# 「安全な」復元はリテールNANDをブリックするリスクが高いです。
# NTRBootHaxを実行している場合、システムがエクスプロイトされているかどうかを知る方法はありません。
# リスクを理解している場合は、次の2行をコメントアウトしてください。
set ERRORMSG "セーフリストアはntrbootでは利用できません。\nブリックを避けるために中止しています。"
chk -u $[HAX] "ntrboot"
set ERRORMSG "SysNANDは変更されませんでした。"
if filesel "NANDバックアップを選択してください。" $[GM9OUT]/*nand_???.bin NANDBAK
    if ask "以下をSysNANDに安全に復元しますか？\n$[NANDBAK]"
        allow S:/ctrnand_full.bin
        allow S:/twln.bin
        allow S:/twlp.bin
        set ERRORMSG "有効なNANDバックアップではありません。"
        imgmount $[NANDBAK]
        if find I:/ctrnand_full.bin NULL
            if find I:/twln.bin NULL
                if find I:/twlp.bin NULL
                    # 下の「verify」コマンドのコメントを外すと検証が有効になります。
                    # firmパーティションに影響を与えないため、コメントアウトしてあります。
                    # ブリックされたイメージからのコンテンツ復元を試行したくない場合は、有効にしてください。
                    #verify I:/nand_minsize.bin
                    set ERRORMSG "転送中にエラーが発生しました。\nもう一度試してください。"
                    cp -w -n I:/ctrnand_full.bin S:/ctrnand_full.bin
                    cp -w -n I:/twln.bin S:/twln.bin
                    cp -w -n I:/twlp.bin S:/twlp.bin
                    rm -o -s 1:/data/$[SYSID0]/sysdata/00010011/00000000
                    imgumount
                else
                    echo "有効なNANDバックアップではありません。"
                end
            else
                echo "有効なNANDバックアップではありません。"
            end
        else
            echo "有効なNANDバックアップではありません。"
        end
    end
end
goto nm_menu

@nmopt_LEFT_Transfer_Emu_to_Sys
if find E:/nand.bin NULL
    set ERRORMSG "適切なエクスプロイトが見つかりません。\nデバイスのブリックを避けるために中止しています。"
    if chk -u $[HAX] ""
        set SUCCESSMSG "EmuNANDがSysNANDに正常に転送されました。"
        set ERRORMSG "EmuNANDをSysNANDに転送できませんでした。"
        if ask "SysNANDのバックアップがあることを確認してください。\n続行してもよろしいですか？"
            allow S:/nand.bin
            cp -w -n E:/ctrnand_full.bin S:/ctrnand_full.bin
            cp -w -n E:/twln.bin S:/twln.bin
            cp -w -n E:/twlp.bin S:/twlp.bin
            rm -o -s 1:/data/$[SYSID0]/sysdata/00010011/00000000
        end
    else
        echo "適切なエクスプロイトが見つかりません。\nデバイスのブリックを避けるために中止しています。"
    end
else
    echo "EmuNANDが見つかりません。"
end
goto nm_menu

@nmopt_RIGHT_Transfer_Sys_to_Emu
if find E:/nand.bin NULL
    set SUCCESSMSG "SysNANDがEmuNANDに正常に転送されました。"
    set ERRORMSG "SysNANDをEmuNANDに転送できませんでした。"
    if ask "EmuNANDのバックアップがあることを確認してください。\n続行してもよろしいですか？"
        allow E:/nand_minsize.bin
        inject -n S:/nand_minsize.bin E:/nand.bin@0
        rm -o -s 4:/data/$[EMUID0]/sysdata/00010011/00000000
    end
else
    echo "EmuNANDが見つかりません。"
end
goto nm_menu

@nmopt_START_Reboot
reboot

@nmopt_SELECT_Power_Off
poweroff

@nmopt_UP_Exit_Script
